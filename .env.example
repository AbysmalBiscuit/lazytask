# Copy this file to `.env` and adjust the values, then `docker compose up -d`.
# `.env` is read automatically by docker compose / podman compose.

# Client UUID this server is allowed to sync with. Generate fresh per server:
#   echo "CLIENT_ID=$(uuidgen | tr 'A-Z' 'a-z')" > .env
# Leave commented out to accept any client UUID (less safe; fine for local dev).
#CLIENT_ID=00000000-0000-0000-0000-000000000000

# Host port to expose the sync server on. The container listens on 8080
# internally; this is what you'll use as the Server URL inside LazyTask
# (http://localhost:${LAZYTASK_SYNC_PORT}).
LAZYTASK_SYNC_PORT=8810

# Server log verbosity. trace > debug > info > warn > error.
RUST_LOG=info
